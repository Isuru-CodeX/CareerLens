# CareerLens AI Environment Configuration
PROJECT_NAME="CareerLens AI"
VERSION="1.0.0"
SECRET_KEY="super-secret-careerlens-production-grade-key-2026-change-in-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DATABASE_URL="sqlite:///./careerlens.db"
UPLOAD_DIR="./storage"
MAX_UPLOAD_SIZE_MB=10
# AI Provider Keys (Optional: Gemini, OpenAI, or Anthropic)
# To use Google Gemini: set LLM_PROVIDER="gemini" and add your GEMINI_API_KEY below.
LLM_PROVIDER="gemini"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Email Dispatch / SMTP Settings
# For Gmail: Use an App Password (Google Account > Security > 2-Step Verification > App Passwords)
# Leave SMTP_USER empty to run in local console mock mode (prints reset link directly in terminal)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_TLS=True
EMAILS_FROM_EMAIL=""
EMAILS_FROM_NAME="CareerLens AI"
FRONTEND_URL="http://localhost:5173"

CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]


