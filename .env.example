# CareerLens AI Environment Configuration
PROJECT_NAME="CareerLens AI"
VERSION="1.0.0"

# Security & Secrets (Change in production)
SECRET_KEY="super-secret-careerlens-production-grade-key-2026-change-in-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database URL
# SQLite default for local development:
DATABASE_URL="sqlite:///./careerlens.db"
# PostgreSQL production example:
# DATABASE_URL="postgresql+psycopg2://careerlens_user:secret_password@localhost:5432/careerlens_db"

# Storage Settings
UPLOAD_DIR="./storage"
MAX_UPLOAD_SIZE_MB=10

# AI Provider API Keys (Optional - Heuristic & local synthesis engine operates out-of-the-box if left blank)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Live Job Market Sources (Optional: Adzuna app_id and app_key for deep histograms; Remotive & Arbeitnow run free)
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# Email Dispatch / SMTP Settings
# Leave SMTP_USER empty to run in local console mock mode (prints reset link directly in terminal)
# For Gmail: Use an App Password (Google Account > Security > 2-Step Verification > App Passwords)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_TLS=True
EMAILS_FROM_EMAIL=""
EMAILS_FROM_NAME="CareerLens AI"
FRONTEND_URL="http://localhost:5173"

# Frontend CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]

